// Jenkinsfile - Proyek Akhir CI/CD (React App, Windows agent, scripted pipeline)

node {

    stage('Checkout') {
        checkout scm

        // bersihkan log lama
        bat 'del pipeline.log 2>nul'
    }

    stage('Install Dependencies') {
        bat '''
echo ===== INSTALL DEPENDENCIES =====>> pipeline.log
set "NODE_OPTIONS="
npm install >> pipeline.log 2>&1
'''
    }

    stage('Build') {
        bat '''
echo ===== BUILD =====>> pipeline.log
set "NODE_OPTIONS=--openssl-legacy-provider"
npm run build >> pipeline.log 2>&1
'''
    }

    stage('Test') {
        bat '''
echo ===== TEST =====>> pipeline.log
set "NODE_OPTIONS=--openssl-legacy-provider"
npm test -- --watch=false --passWithNoTests >> pipeline.log 2>&1
'''
        // kalau mau, bisa tambah junit parsing di sini kalau ada report
    }

    stage('Manual Approval') {
        // Kriteria 4: manual approval sebelum Deploy
        // Munculkan pertanyaan: "Lanjutkan ke tahap Deploy?"
        timeout(time: 10, unit: 'MINUTES') {
            def userInput = input(
                id: 'ProceedToDeploy',
                message: 'Lanjutkan ke tahap Deploy?',
                parameters: [
                    choice(
                        name: 'Konfirmasi',
                        choices: 'Proceed\nAbort',
                        description: 'Pilih Proceed untuk lanjut ke Deploy, Abort untuk menghentikan pipeline.'
                    )
                ]
            )

            if (userInput != 'Proceed') {
                error "Pipeline dihentikan oleh user di tahap Manual Approval."
            }
        }
    }

    stage('Deploy') {
        // Kriteria 2 & 3: Deploy + app jalan 1 menit, lalu berhenti otomatis
        // Di sini contoh sederhana: jalankan React dev server, diam 60 detik, lalu kill.

        // Pastikan tidak ada proses lama yang masih jalan
        // (opsional, tergantung cara sebelumnya deploy)
        bat '''
echo ===== DEPLOY (START) =====>> pipeline.log

REM Menjalankan aplikasi React (contoh: npm start) di background menggunakan start
start "react-app" cmd /c "set NODE_OPTIONS=--openssl-legacy-provider && npm start"

echo Aplikasi berjalan. Menunggu 60 detik...>> pipeline.log
timeout /t 60 /nobreak >nul

echo 60 detik selesai, menghentikan aplikasi...>> pipeline.log

REM (opsional) coba hentikan proses node/npm yang berjalan di port 3000
REM Misal pakai npx kill-port 3000 jika tersedia:
REM npx kill-port 3000

echo ===== DEPLOY (END) =====>> pipeline.log
'''

        // Catatan:
        // - Karena di requirement: "gunakan perintah sleep", di Windows ekivalennya timeout /t 60.
        // - Kalau nanti Jenkins jalan di Linux (Docker), ganti block di atas jadi:
        //   sh '''
        //   npm start &
        //   sleep 60
        //   pkill -f "npm start" || true
        //   '''
    }

    stage('Archive Build Artifacts') {
        archiveArtifacts artifacts: 'build/**/*,pipeline.log', fingerprint: true
    }
}
