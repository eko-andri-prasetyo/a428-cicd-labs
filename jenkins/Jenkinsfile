// Jenkinsfile - Proyek Akhir CI/CD (React App, Windows, Scripted Pipeline)

node {

    stage('Checkout') {
        // Ambil source code dari SCM (branch react-app)
        checkout scm

        // Bersihkan log lama kalau ada
        bat 'del pipeline.log 2>nul'
    }

    stage('Install Dependencies') {
        bat '''
echo ===== INSTALL DEPENDENCIES =====>> pipeline.log
set "NODE_OPTIONS="
npm install >> pipeline.log 2>&1
'''
    }

    stage('Build') {
        bat '''
echo ===== BUILD =====>> pipeline.log
set "NODE_OPTIONS=--openssl-legacy-provider"
npm run build >> pipeline.log 2>&1
'''
    }

    stage('Test') {
        bat '''
echo ===== TEST =====>> pipeline.log
set "NODE_OPTIONS=--openssl-legacy-provider"
npm test -- --watch=false --passWithNoTests >> pipeline.log 2>&1
'''
    }

    stage('Manual Approval') {
        // Kriteria 4: Manual Approval sebelum Deploy
        timeout(time: 10, unit: 'MINUTES') {
            def userInput = input(
                id: 'ProceedToDeploy',
                message: 'Lanjutkan ke tahap Deploy?',
                parameters: [
                    choice(
                        name: 'Konfirmasi',
                        choices: 'Proceed\nAbort',
                        description: 'Pilih Proceed untuk lanjut ke Deploy, Abort untuk menghentikan pipeline.'
                    )
                ]
            )

            if (userInput != 'Proceed') {
                error "Pipeline dihentikan oleh user di tahap Manual Approval."
            }
        }
    }

    stage('Deploy') {
        // Kriteria 2 & 3:
        // - Deploy aplikasi (serve build React)
        // - Biarkan hidup 60 detik
        // - Matikan lagi, pipeline tetap SUCCESS

        bat '''
echo ===== DEPLOY (START) =====>> pipeline.log

REM Pastikan package serve terpasang (kalau sudah, perintah ini akan cepat)
call npm install -g serve >> pipeline.log 2>&1

REM Pindah ke workspace Jenkins
cd /d %WORKSPACE%

REM Jalankan aplikasi React dari folder build di background di port 3000
start "react-serve" cmd /c "serve -s build -l 3000"

echo Aplikasi berjalan di http://localhost:3000 . Menunggu 60 detik...>> pipeline.log

REM Tunggu 60 detik (pakai PowerShell biar nggak error di Jenkins)
powershell -Command "Start-Sleep -Seconds 60"

echo 60 detik selesai, menghentikan aplikasi...>> pipeline.log

REM Hentikan proses node (server serve)
taskkill /F /IM node.exe >nul 2>&1

echo ===== DEPLOY (END) =====>> pipeline.log
'''
    }

    stage('Archive Build Artifacts') {
        // Arsipkan build + pipeline.log untuk dikirim ke Dicoding (log.txt)
        archiveArtifacts artifacts: 'build/**/*,pipeline.log', fingerprint: true
    }
}
