// Scripted Pipeline untuk React App - Windows (npm di host)

node {
    stage('Checkout') {
        // Ambil kode dari SCM (GitHub) menggunakan konfigurasi di job Jenkins
        checkout scm
    }

    stage('Install Dependencies') {
        // Pastikan Node.js + npm sudah ter-install di Windows dan PATH-nya benar
        bat 'npm ci'
    }

    stage('Build') {
        bat 'npm run build'
    }

    stage('Test') {
        // --watch=false supaya nggak nyangkut
        bat 'npm test -- --watch=false'
    }

    stage('Archive Build Artifacts') {
        // Arsipkan hasil build untuk dilihat di Artifacts
        archiveArtifacts artifacts: 'build/**/*', fingerprint: true
    }
}
